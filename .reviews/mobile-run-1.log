+/* ======================================================================
+ *  INPUT-TOUCH — Touch-Steuerung über Pointer-Events (SPEC-mobile)
+ *  Maus-Logik oben bleibt unangetastet: Touch-Pointer (pointerType
+ *  touch/pen) werden von den Maus-Handlern ignoriert und ausschließ-
+ *  lich hier verarbeitet. Ein Finger = Tap oder Pan (12-px-Schwelle),
+ *  zwei Finger = Pinch-Zoom um den Finger-Mittelpunkt.
+ * ====================================================================== */
+
+const TAP_SLOP = 12;          // Bewegungsschwelle: darunter = Tap, darüber = Pan
+const ZOOM_MIN = 0.35, ZOOM_MAX = 2.2;  // wie Mausrad
+
+const touchPtrs = new Map();  // pointerId -> { x, y }
+let tapState = null;          // laufender Einzel-Finger { id, sx, sy, lx, ly, moved }
+let pinchState = null;        // Pinch-Anker { d0, wx, wy }
+
+canvas.addEventListener("pointerdown", (e) => {
+  if (!isTouchPointer(e)) return;         // Maus: bestehende Handler
+  if (G.over || G.paused) return;
+  canvas.setPointerCapture(e.pointerId);
+  touchPtrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
+
+  if (touchPtrs.size === 1) {
+    // erster Finger: potenzieller Tap (wird erst beim Loslassen ausgewertet)
+    tapState = { id: e.pointerId, sx: e.clientX, sy: e.clientY,
+                 lx: e.clientX, ly: e.clientY, moved: false };
+  } else if (touchPtrs.size === 2) {
+    // zweiter Finger: Tap verwerfen, Pinch starten (Mittelpunkt-Anker)
+    tapState = null;
+    const [a, b] = [...touchPtrs.values()];
+    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
+    const w = screenToWorld(mx, my);
+    pinchState = { d0: Math.hypot(a.x - b.x, a.y - b.y) || 1, wx: w.x, wy: w.y };
+  }
+  e.preventDefault(); // Long-Press-Menü & Kompatibilitäts-Maus-Events unterdrücken
+});
+
+canvas.addEventListener("pointermove", (e) => {
+  if (!isTouchPointer(e) || !touchPtrs.has(e.pointerId)) return;
+  const p = touchPtrs.get(e.pointerId);
+  p.x = e.clientX; p.y = e.clientY;
+
+  if (touchPtrs.size >= 2 && pinchState) {
+    // Pinch: Zoom um den Finger-Mittelpunkt (Klemmen an Zoom-Grenzen)
+    const [a, b] = [...touchPtrs.values()];
+    const dist = Math.hypot(a.x - b.x, a.y - b.y) || 1;
+    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
+    G.cam.zoom = clamp(G.cam.zoom * (dist / pinchState.d0), ZOOM_MIN, ZOOM_MAX);
+    // Weltpunkt unter dem Mittelpunkt festhalten (Zoom + zugleich Pan)
+    const w = screenToWorld(mx, my);
+    G.cam.x += pinchState.wx - w.x;
+    G.cam.y += pinchState.wy - w.y;
+    pinchState.d0 = dist;                 // relativ weiterzoomen
+    pinchState.wx = w.x; pinchState.wy = w.y;
+    clampCam();
+    return;
+  }
+
+  if (tapState && e.pointerId === tapState.id) {
+    const dx = e.clientX - tapState.sx, dy = e.clientY - tapState.sy;
+    if (!tapState.moved && Math.hypot(dx, dy) > TAP_SLOP) tapState.moved = true;
+    if (tapState.moved) {                 // ab Schwelle: Kamera-Pan (ein Finger)
+      G.cam.x -= (e.clientX - tapState.lx) / G.cam.zoom;
+      G.cam.y -= (e.clientY - tapState.ly) / G.cam.zoom;
+      clampCam();
+    }
+    tapState.lx = e.clientX; tapState.ly = e.clientY;
+  }
+});
+
+function touchPointerEnd(e) {
+  if (!isTouchPointer(e) || !touchPtrs.has(e.pointerId)) return;
+  touchPtrs.delete(e.pointerId);
+
+  if (touchPtrs.size < 2) pinchState = null;
+
+  if (tapState && e.pointerId === tapState.id) {
+    if (!tapState.moved) handleTouchTap(tapState.sx, tapState.sy);
+    tapState = null;
+  } else if (touchPtrs.size === 1) {
+    // nach Pinch-Abbruch: verbleibender Finger wird sofort Pan-Anker
+    const [id, p] = [...touchPtrs.entries()][0];
+    tapState = { id, sx: p.x, sy: p.y, lx: p.x, ly: p.y, moved: true };
+  }
+}
+canvas.addEventListener("pointerup", touchPointerEnd);
+canvas.addEventListener("pointercancel", touchPointerEnd);
+
+/* Tap-Auswertung (SPEC-mobile):
+   - Tap auf EIGENE Truppe  -> auswählen
+   - Tap auf FEIND (mit eigener Auswahl) -> Angriffsbefehl
+   - Tap auf freien Boden (mit eigener Auswahl) -> Marschbefehl
+   - Tap ohne Auswahl auf Feind/Boden -> nichts (kein Fehlbefehl) */
+function handleTouchTap(sx, sy) {
+  if (G.over || G.paused) return;
+  const w = screenToWorld(sx, sy);
+  const own = troopAt(w.x, w.y, 0, true);
+  if (own) { G.selected = G.playerTroops.indexOf(own); return; }
+  if (G.selected === null) return;        // kein versehentlicher Befehl
+  issueOrder(sx, sy, true);
+}
+
+/* contextmenu auch für Long-Press-Touch unterdrücken (Maus-Rechtsklick
+   auf dem Canvas ist bereits oben blockiert). */
+document.addEventListener("contextmenu", (e) => {
+  if (touchPtrs.size > 0) e.preventDefault();
+});
+
 function selectedTroop() {
   if (G.selected === null) return null;
   const t = G.playerTroops[G.selected];
   return (t && t.alive) ? t : null;

