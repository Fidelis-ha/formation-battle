// F1: exakte Alive-Checks
check("F1a updateCombat: \x27if (!v.alive) continue;\x27", /for \(const v of f\.soldiers\) \{\n\s+if \(!v\.alive\) continue;/m.test(js));
check("F1b updateProjectiles: \x27if (!s.alive) continue;\x27", /for \(const s of t\.soldiers\) \{\n\s+if \(!s\.alive\) continue;/m.test(js));

// Reihenfolge-Check: F1a in updateCombat (nach Funktionsstart), F1b in updateProjectiles
const uc = js.slice(js.indexOf("function updateCombat"));
const up = js.slice(js.indexOf("function updateProjectiles"), js.indexOf("function soldierGap"));
check("F1a liegt in updateCombat", uc.includes("if (!v.alive) continue;") && uc.indexOf("if (!v.alive) continue;") < uc.indexOf("if (best)"));
check("F1b liegt in updateProjectiles", up.includes("if (!s.alive) continue;"));

// F2
check("F2 dest=null bei Punkt-Ankunft", js.includes("} else if (!wantMove.soldiers) {") && js.includes("t.dest = null;"));
// F3
check("F3 Housecarl \x27atk === \x22housecarl\x22 && !isRanged\x27", js.includes(`if (atk === "housecarl" && !isRanged) return 1.3;`));
// F4
check("F4 mousedown G.paused return", /canvas\.addEventListener\("mousedown", \(e\) => \{\s*\n\s*if \(G\.over\) return;\s*\n\s*if \(G\.paused\) return;/.test(js));
